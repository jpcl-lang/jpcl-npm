{
  "name": "jpml-lang",
  "version": "1.1.1",
  "description": "A hybrid JSON/TOML configuration language (.jp files)",
  "keywords": [
    "config",
    "configuration",
    "parser",
    "toml",
    "json",
    "jp",
    "jpml"
  ],
  "homepage": "https://github.com/jpml-lang/jpml-npm#readme",
  "bugs": {
    "url": "https://github.com/jpml-lang/jpml-npm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpml-lang/jpml-npm.git"
  },
  "license": "MIT",
  "author": "Clove Twilight <admin@doughmination.win>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "jpml": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "bun test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2"
  }
}
